# Settings for running the Edge Functions on your own computer.
# Copy this file to supabase/functions/.env (that file is gitignored) and adjust.

# Which AI writes Luna's replies: groq (the default), openai, huggingface, anthropic, or ollama
LUNA_PROVIDER=ollama

# Ollama on this Mac, as seen from inside Supabase's Docker containers
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_FAST_MODEL=llama3.2
OLLAMA_THOUGHTFUL_MODEL=qwen2.5:7b

# Only needed for the other providers
# ANTHROPIC_API_KEY=
# HF_TOKEN=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# OPENAI_FAST_MODEL=
# OPENAI_THOUGHTFUL_MODEL=
