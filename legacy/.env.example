# Copy to .env and fill in. .env is gitignored — never commit real keys.
# All keys are read server-side only; nothing here is ever sent to the browser.

# --- Server ---
PORT=3000
# Keep 127.0.0.1 unless you know you want Luna reachable from other devices.
HOST=127.0.0.1

# --- AI provider ---
# One of: anthropic | openai | ollama
# "ollama" runs a model locally, so journal text never leaves your computer.
AI_PROVIDER=
# The model name for that provider, e.g. claude-sonnet-5-5 (anthropic) or llama3.1 (ollama).
AI_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# --- Notion (used from Phase 2) ---
# Create an internal integration at https://www.notion.so/my-integrations,
# then share your journal database with it.
NOTION_TOKEN=
NOTION_DATABASE_ID=
